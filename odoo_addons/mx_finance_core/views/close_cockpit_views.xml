<odoo>
    <record id="view_mx_close_cockpit_tree" model="ir.ui.view">
        <field name="name">mx.close.cockpit.tree</field>
        <field name="model">mx.close.cockpit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="ledger_id"/>
                <field name="period_key"/>
                <field name="status"/>
            </tree>
        </field>
    </record>
    <record id="action_mx_close_cockpit" model="ir.actions.act_window">
        <field name="name">Close Cockpit</field>
        <field name="res_model">mx.close.cockpit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
