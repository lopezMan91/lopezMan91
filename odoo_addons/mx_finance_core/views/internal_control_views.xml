<odoo>
    <record id="view_mx_control_library_tree" model="ir.ui.view">
        <field name="name">mx.control.library.tree</field>
        <field name="model">mx.control.library</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="control_type"/>
                <field name="owner_id"/>
                <field name="frequency"/>
                <field name="severity"/>
            </tree>
        </field>
    </record>
    <record id="action_mx_control_library" model="ir.actions.act_window">
        <field name="name">Control Library</field>
        <field name="res_model">mx.control.library</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_mx_sod_rule_tree" model="ir.ui.view">
        <field name="name">mx.sod.rule.tree</field>
        <field name="model">mx.sod.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="role_a"/>
                <field name="role_b"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="action_mx_sod_rule" model="ir.actions.act_window">
        <field name="name">SoD Rules</field>
        <field name="res_model">mx.sod.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_mx_ccm_alert_tree" model="ir.ui.view">
        <field name="name">mx.ccm.alert.tree</field>
        <field name="model">mx.ccm.alert</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="alert_type"/>
                <field name="severity"/>
                <field name="status"/>
            </tree>
        </field>
    </record>
    <record id="action_mx_ccm_alert" model="ir.actions.act_window">
        <field name="name">CCM Alerts</field>
        <field name="res_model">mx.ccm.alert</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
