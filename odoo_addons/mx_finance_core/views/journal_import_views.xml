<odoo>
    <record id="view_mx_journal_import_batch_tree" model="ir.ui.view">
        <field name="name">mx.journal.import.batch.tree</field>
        <field name="model">mx.journal.import.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="import_uid"/>
                <field name="company_id"/>
                <field name="ledger_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="action_mx_journal_import_batch" model="ir.actions.act_window">
        <field name="name">Journal Import Staging</field>
        <field name="res_model">mx.journal.import.batch</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
