<odoo>
    <record id="view_mx_finance_ledger_tree" model="ir.ui.view">
        <field name="name">mx.finance.ledger.tree</field>
        <field name="model">mx.finance.ledger</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="principle"/>
                <field name="company_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mx_finance_ledger_form" model="ir.ui.view">
        <field name="name">mx.finance.ledger.form</field>
        <field name="model">mx.finance.ledger</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="principle"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mx_finance_ledger" model="ir.actions.act_window">
        <field name="name">Ledgers</field>
        <field name="res_model">mx.finance.ledger</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
