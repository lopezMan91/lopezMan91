<odoo>
    <record id="view_mx_rate_table_tree" model="ir.ui.view">
        <field name="name">mx.rate.table.tree</field>
        <field name="model">mx.rate.table</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="rate_type"/>
                <field name="rate"/>
                <field name="source"/>
                <field name="locked_period"/>
            </tree>
        </field>
    </record>
    <record id="action_mx_rate_table" model="ir.actions.act_window">
        <field name="name">FX Rates</field>
        <field name="res_model">mx.rate.table</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
